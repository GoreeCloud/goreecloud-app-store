{
  "schemaVersion": 1,
  "application": "goreecloud-app-store",
  "productionAcceptance": false,
  "nativeApplication": true,
  "nativeClients": {
    "android": {
      "implemented": true,
      "framework": "Kotlin + Jetpack Compose",
      "developmentApplicationId": "com.goreecloud.appstore.dev",
      "productionConnected": false
    },
    "linux": {
      "implemented": true,
      "framework": "GTK 4 + libadwaita",
      "language": "Rust",
      "developmentApplicationId": "com.goreecloud.AppStore.Development",
      "developmentBinary": "goreecloud-app-store-dev",
      "productionConnected": false
    }
  },
  "integrations": {
    "glazeUi": {
      "target": "2.1.0",
      "stableReleaseTag": "v2.1.0",
      "stableReleaseRevision": "c49113eb8b93c267613fdf1bbca1f814495acad7",
      "adoptionStatus": "adoption-candidate",
      "adoptionEvidence": "contracts/glaze-ui-adoption.json",
      "automatedContract": true,
      "nativeMappings": ["android", "linux"],
      "conformanceAccepted": false
    },
    "goreecloudIdentity": {
      "sourceBoundaryImplemented": true,
      "productionConnected": false,
      "authority": ["identity", "authentication", "authorization", "accounts", "devices", "credentials", "sessions", "delegated-authority"]
    },
    "wardveilSecurity": {
      "sourceBoundaryImplemented": true,
      "productionConnected": false,
      "authority": ["package-trust", "verification", "protection", "security-response"]
    },
    "privacyShield": {
      "sourceBoundaryImplemented": true,
      "productionConnected": false,
      "developmentAnalytics": false
    },
    "everkeep": {
      "sourceBoundaryImplemented": true,
      "productionConnected": false,
      "authority": ["library-recovery", "history-preservation", "continuity-evidence"]
    },
    "goreecloudMesh": {
      "sourceBoundaryImplemented": true,
      "productionConnected": false,
      "authority": ["catalog-coordination", "capability-discovery", "lifecycle-events"]
    }
  }
}
