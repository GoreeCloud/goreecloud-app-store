{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.example/contracts/release-manifest.schema.json",
  "title": "GoreeCloud App Store authorized release manifest",
  "description": "Proposed protected response contract for concrete application releases. It does not authorize delivery by itself; the delivery backend must re-authorize every artifact request.",
  "type": "object",
  "required": ["schemaVersion", "itemId", "releases"],
  "properties": {
    "schemaVersion": {"const": 1},
    "itemId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
    "releases": {
      "type": "array",
      "items": {"$ref": "#/$defs/release"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "release": {
      "type": "object",
      "required": [
        "releaseId",
        "version",
        "channel",
        "publicationState",
        "platforms",
        "releaseNotes",
        "sourceRevision"
      ],
      "properties": {
        "releaseId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "channel": {"enum": ["stable", "release-candidate", "beta", "debug"]},
        "publicationState": {"enum": ["published", "blocked", "withdrawn"]},
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["android", "linux", "web"]}
        },
        "releaseNotes": {"type": "string"},
        "sourceRevision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
